{
  "name": "icloud-google-calendar-sync",
  "version": "0.1.0",
  "description": "Two-way iCloud \u2194 Google Calendar mirror. Stateless, zero dependencies, runs as a CLI or a single HTTP handler.",
  "keywords": [
    "icloud",
    "google-calendar",
    "caldav",
    "calendar",
    "sync",
    "mirror",
    "two-way",
    "agents",
    "ical"
  ],
  "license": "MIT",
  "author": "jdubba1",
  "repository": "github:jdubba1/icloud-google-calendar-sync",
  "homepage": "https://github.com/jdubba1/icloud-google-calendar-sync#readme",
  "bugs": "https://github.com/jdubba1/icloud-google-calendar-sync/issues",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "bin": {
    "icloud-google-calendar-sync": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "mirror.config.example.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm typecheck && pnpm test && pnpm format:check && pnpm build",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.14.0"
}
